# A changed compiler, configuration or runtime source needs a fresh VM build.
file(REMOVE_RECURSE "@luajit_build_dir@")
file(MAKE_DIRECTORY "@luajit_build_dir@")
file(MAKE_DIRECTORY "@luajit_build_dir@/objects")
set(object_names "@luajit_object_names@")
file(READ "@luajit_source@/.relver" release)
string(STRIP "${release}" release)
if(NOT release MATCHES "^[0-9]+$")
  execute_process(COMMAND "@GIT_EXECUTABLE@" -C "@luajit_source@" log -1 --format=%ct
                  OUTPUT_VARIABLE release OUTPUT_STRIP_TRAILING_WHITESPACE
                  RESULT_VARIABLE result)
  if(NOT result EQUAL 0 OR NOT release MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Cannot determine the LuaJIT release version.")
  endif()
endif()

if("@WIN32@" AND NOT "@MINGW@")
  file(COPY "@luajit_source@/" DESTINATION "@luajit_build_dir@/source" PATTERN ".git" EXCLUDE)
  file(WRITE "@luajit_build_dir@/source/.relver" "${release}\n")
  set(src "@luajit_build_dir@/source/src")
  # Match librime's CRT; the upstream static build otherwise defaults to /MT.
  file(READ "${src}/msvcbuild.bat" batch)
  string(REPLACE "@set LJCOMPILE=cl " "@set LJCOMPILE=cl @luajit_crt@ " batch "${batch}")
  string(REPLACE "@del *.obj *.manifest" "@del *.manifest" batch "${batch}")
  file(WRITE "${src}/msvcbuild.bat" "${batch}")
  set(debug_arg)
  if("@luajit_config@" STREQUAL "Debug")
    set(debug_arg debug)
  endif()
  execute_process(COMMAND cmd /c msvcbuild.bat lua52compat ${debug_arg} static
                  WORKING_DIRECTORY "${src}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0 OR NOT EXISTS "${src}/lua51.lib" OR
     NOT EXISTS "${src}/luajit.exe")
    message(FATAL_ERROR "Bundled LuaJIT build failed (${result}).")
  endif()
  foreach(name IN LISTS object_names)
    file(COPY "${src}/${name}" DESTINATION "@luajit_build_dir@/objects")
  endforeach()
  file(TOUCH "@luajit_build_dir@/luajit.stamp")
  return()
endif()

set(architectures native)
if("@APPLE@" AND NOT "@CMAKE_OSX_ARCHITECTURES@" STREQUAL "")
  set(architectures "@CMAKE_OSX_ARCHITECTURES@")
endif()
foreach(arch IN LISTS architectures)
  set(work "@luajit_build_dir@/${arch}")
  file(COPY "@luajit_source@/" DESTINATION "${work}" PATTERN ".git" EXCLUDE)
  file(WRITE "${work}/.relver" "${release}\n")
  set(target_flags "@luajit_target_flags@ -fPIC")
  set(make_args "BUILDMODE=static" "CC=\"@CMAKE_C_COMPILER@\""
                "HOST_CC=\"@luajit_host_cc@\""
                "XCFLAGS=-DLUAJIT_ENABLE_LUA52COMPAT"
                "TARGET_AR=\"@CMAKE_AR@\" rcs")
  set(build_env)
  if("@APPLE@")
    set(deployment_target "@CMAKE_OSX_DEPLOYMENT_TARGET@")
    if(deployment_target STREQUAL "")
      execute_process(COMMAND sw_vers -productVersion OUTPUT_VARIABLE deployment_target
                      OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
      if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot determine the macOS deployment target.")
      endif()
    endif()
    list(APPEND build_env "MACOSX_DEPLOYMENT_TARGET=${deployment_target}")
    string(APPEND target_flags " -mmacosx-version-min=${deployment_target}")
    if(NOT arch STREQUAL "native")
      string(APPEND target_flags " -arch ${arch}")
    endif()
    if(NOT "@CMAKE_OSX_SYSROOT@" STREQUAL "")
      string(APPEND target_flags " -isysroot \"@CMAKE_OSX_SYSROOT@\"")
    endif()
  elseif("@MINGW@")
    list(APPEND make_args "TARGET_SYS=Windows" "HOST_SYS=Windows")
  elseif("@CMAKE_CROSSCOMPILING@")
    list(APPEND make_args "TARGET_SYS=@CMAKE_SYSTEM_NAME@")
  endif()
  list(APPEND make_args "TARGET_FLAGS=${target_flags}")
  execute_process(COMMAND "@CMAKE_COMMAND@" -E env --unset=MAKEFLAGS --unset=MFLAGS ${build_env}
                          "@luajit_make@" -j2 ${make_args}
                  WORKING_DIRECTORY "${work}/src" RESULT_VARIABLE result)
  if(NOT result EQUAL 0 OR NOT EXISTS "${work}/src/libluajit.a")
    message(FATAL_ERROR "Bundled LuaJIT build failed for ${arch} (${result}).")
  endif()
endforeach()
list(LENGTH architectures count)
foreach(name IN LISTS object_names)
  set(inputs)
  foreach(arch IN LISTS architectures)
    list(APPEND inputs "@luajit_build_dir@/${arch}/src/${name}")
  endforeach()
  if(count GREATER 1)
    execute_process(COMMAND lipo -create ${inputs}
                            -output "@luajit_build_dir@/objects/${name}"
                    RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Cannot combine LuaJIT object ${name} (${result}).")
    endif()
  else()
    file(COPY ${inputs} DESTINATION "@luajit_build_dir@/objects")
  endif()
endforeach()
file(TOUCH "@luajit_build_dir@/luajit.stamp")
