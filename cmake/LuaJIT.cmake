# LuaJIT's build tools generate architecture-specific VM code before compiling C.
# Keep those generated files in the build tree and use the upstream build system.
set(luajit_source "${CMAKE_CURRENT_SOURCE_DIR}/thirdparty/luajit")
if(NOT EXISTS "${luajit_source}/src/lua.h")
  message(FATAL_ERROR "Initialize LuaJIT with: git submodule update --init --recursive")
endif()
file(GLOB_RECURSE luajit_sources CONFIGURE_DEPENDS "${luajit_source}/*")
list(FILTER luajit_sources EXCLUDE REGEX "/[.]git(/|$)")
list(APPEND luajit_sources "${luajit_source}/.relver")
if(EXISTS "${luajit_source}/.git")
  find_package(Git REQUIRED)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${luajit_source}" rev-parse --git-path HEAD
                  OUTPUT_VARIABLE luajit_git_head OUTPUT_STRIP_TRAILING_WHITESPACE
                  RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot read the LuaJIT submodule revision.")
  endif()
  get_filename_component(luajit_git_head "${luajit_git_head}" ABSOLUTE BASE_DIR "${luajit_source}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${luajit_git_head}")
  list(APPEND luajit_sources "${luajit_git_head}")
endif()

if(WIN32 AND NOT MINGW)
  find_program(luajit_cl cl)
  if(NOT luajit_cl)
    message(FATAL_ERROR "Bundled LuaJIT requires a Visual Studio developer environment.")
  endif()
  set(luajit_object_suffix .obj)
else()
  find_program(luajit_make NAMES gmake make mingw32-make)
  if(NOT luajit_make)
    message(FATAL_ERROR "Bundled LuaJIT requires GNU Make.")
  endif()
  set(luajit_object_suffix .o)
endif()

file(GLOB luajit_c_sources "${luajit_source}/src/lj_*.c" "${luajit_source}/src/lib_*.c")
set(luajit_object_names "lj_vm${luajit_object_suffix}")
foreach(source IN LISTS luajit_c_sources)
  get_filename_component(name "${source}" NAME_WE)
  list(APPEND luajit_object_names "${name}${luajit_object_suffix}")
endforeach()

if(CMAKE_CROSSCOMPILING AND NOT APPLE AND NOT WIN32)
  find_program(luajit_host_cc NAMES cc gcc clang NO_CMAKE_FIND_ROOT_PATH)
  if(NOT luajit_host_cc)
    message(FATAL_ERROR "LuaJIT cross-compilation requires a native C compiler.")
  endif()
else()
  set(luajit_host_cc "${CMAKE_C_COMPILER}")
endif()

set(luajit_configurations ${CMAKE_CONFIGURATION_TYPES})
if(NOT luajit_configurations)
  set(luajit_configurations "${CMAKE_BUILD_TYPE}")
endif()
if(NOT luajit_configurations)
  set(luajit_configurations Release)
endif()

add_library(rime-luajit-objs OBJECT IMPORTED GLOBAL)
set(luajit_build_root "${CMAKE_CURRENT_BINARY_DIR}/luajit")
foreach(luajit_config IN LISTS luajit_configurations)
  string(TOUPPER "${luajit_config}" luajit_config_upper)
  set(luajit_build_dir "${luajit_build_root}/${luajit_config}")
  set(luajit_target_flags "${CMAKE_C_FLAGS} ${CMAKE_C_FLAGS_${luajit_config_upper}}")
  set(luajit_crt /MT)
  if(CMAKE_MSVC_RUNTIME_LIBRARY MATCHES "DLL" OR luajit_target_flags MATCHES "/MD")
    set(luajit_crt /MD)
  endif()
  if(luajit_config STREQUAL "Debug")
    string(APPEND luajit_crt d)
  endif()
  configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/BuildLuaJIT.cmake.in"
                 "${luajit_build_root}/build-${luajit_config}.cmake" @ONLY)
  set(objects)
  foreach(name IN LISTS luajit_object_names)
    list(APPEND objects "${luajit_build_dir}/objects/${name}")
  endforeach()
  set_property(TARGET rime-luajit-objs APPEND PROPERTY IMPORTED_CONFIGURATIONS "${luajit_config}")
  set_target_properties(rime-luajit-objs PROPERTIES
    "IMPORTED_OBJECTS_${luajit_config_upper}" "${objects}")
endforeach()

if(CMAKE_CONFIGURATION_TYPES)
  set(luajit_selected_config "$<CONFIG>")
else()
  set(luajit_selected_config "${luajit_configurations}")
endif()
set(luajit_stamp "${luajit_build_root}/${luajit_selected_config}/luajit.stamp")
set(objects)
foreach(name IN LISTS luajit_object_names)
  list(APPEND objects "${luajit_build_root}/${luajit_selected_config}/objects/${name}")
endforeach()
if(NOT CMAKE_CONFIGURATION_TYPES)
  set_target_properties(rime-luajit-objs PROPERTIES IMPORTED_OBJECTS "${objects}")
endif()
add_custom_command(
  OUTPUT "${luajit_stamp}"
  BYPRODUCTS ${objects}
  COMMAND ${CMAKE_COMMAND} -P "${luajit_build_root}/build-${luajit_selected_config}.cmake"
  DEPENDS ${luajit_sources} "${luajit_build_root}/build-${luajit_selected_config}.cmake"
  COMMENT "Building bundled LuaJIT"
  VERBATIM)
add_custom_target(rime-luajit-build DEPENDS "${luajit_stamp}")
add_dependencies(rime-luajit-objs rime-luajit-build)
set(luajit_system_libraries)
if(UNIX)
  set(luajit_system_libraries ${CMAKE_DL_LIBS} m)
endif()
message(STATUS "Using bundled LuaJIT")
